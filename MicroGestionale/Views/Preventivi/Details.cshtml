@model MicroGestionale.Models.Preventivo

@{
    ViewData["Title"] = $"Preventivo {Model.Numero}";
}

<h1>Preventivo @Model.Numero</h1>
<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-action="Stampa"
       asp-route-id="@Model.Id"
       class="btn btn-outline-primary">
        Stampa / PDF
    </a>

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-outline-secondary">
        Modifica testata
    </a>

    <form asp-action="Delete"
          asp-route-id="@Model.Id"
          method="post"
          onsubmit="return confirm('Eliminare definitivamente questo preventivo e tutte le sue righe?');">
        <button type="submit" class="btn btn-outline-danger">
            Elimina preventivo
        </button>
    </form>
</div>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Data</dt>
            <dd class="col-sm-9">
                @Model.Data.ToString("dd/MM/yyyy")
            </dd>

            <dt class="col-sm-3">Cliente</dt>
            <dd class="col-sm-9">@Model.Cliente.Nome</dd>

            <dt class="col-sm-3">Indirizzo</dt>
            <dd class="col-sm-9">
                @Model.Cliente.Indirizzo
                @Model.Cliente.Cap
                @Model.Cliente.Citta
            </dd>

            <dt class="col-sm-3">Valido fino al</dt>
            <dd class="col-sm-9">
                @(Model.ValidoFinoAl?.ToString("dd/MM/yyyy") ?? "—")
            </dd>
        </dl>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Note))
{
    <h2 class="h5">Note</h2>
    <p style="white-space: pre-wrap">@Model.Note</p>
}

<h2 class="h4">Righe del preventivo</h2>

<p>
    <a asp-action="AggiungiRiga"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        Aggiungi riga
    </a>
</p>

@if (!Model.Righe.Any())
{
    <div class="alert alert-info">
        Questo preventivo non contiene ancora righe.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Descrizione</th>
                    <th class="text-end">Quantità</th>
                    <th class="text-end">Prezzo unitario (€)</th>
                    <th class="text-end">Sconto (%)</th>
                    <th class="text-end">IVA (%)</th>
                    <th class="text-end">Totale (€)</th>
                    <th class="text-end">Azioni</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var riga in Model.Righe.OrderBy(r => r.Posizione))
                {
                    <tr>
                        <td>@riga.Descrizione</td>
                        <td class="text-end">
                            @riga.Quantita.ToString("0.###")
                        </td>
                        <td class="text-end">
                            @riga.PrezzoUnitario.ToString("N2")
                        </td>
                        <td class="text-end">
                            @riga.ScontoPercentuale.ToString("0.##")
                        </td>
                        <td class="text-end">
                            @riga.AliquotaIva.ToString("0.##")
                        </td>
                        <td class="text-end">
                            @riga.Totale.ToString("N2")
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="ModificaRiga"
                               asp-route-id="@riga.Id"
                               class="btn btn-sm btn-outline-primary">
                                Modifica
                            </a>

                            <form asp-action="EliminaRiga"
                                  asp-route-id="@riga.Id"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Eliminare questa riga?');">
                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger">
                                    Elimina
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card my-4">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-8">Imponibile</dt>
                <dd class="col-sm-4 text-end">
                    @Model.TotaleImponibile.ToString("N2") €
                </dd>

                <dt class="col-sm-8">IVA</dt>
                <dd class="col-sm-4 text-end">
                    @Model.TotaleIva.ToString("N2") €
                </dd>

                <dt class="col-sm-8">Totale preventivo</dt>
                <dd class="col-sm-4 text-end fw-bold">
                    @Model.TotalePreventivo.ToString("N2") €
                </dd>
            </dl>
        </div>
    </div>
}

<a asp-action="Index" class="btn btn-secondary">
    Torna all’elenco
</a>
